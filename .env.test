# binbrain — test environment
#
# Source this file before running pytest locally:
#   set -a; source .env.test; set +a; pytest api/tests
#
# Or export inline:
#   export $(grep -v '^#' .env.test | xargs)
#
# CRITICAL: NEVER set TEST_DATABASE_URL to a database named `binbrain` (that's
# production). The name MUST contain "_test" so the conftest guard catches any
# misconfiguration. See thoughts/shared/designs/ for the isolation design.

TEST_DATABASE_URL=postgresql+psycopg://binbrain:claude_dev@localhost:5434/binbrain_test
