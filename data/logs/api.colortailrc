# colortail color profile for binbrain api.log
# Usage: colortail -k api.colortailrc -f api.log

# Timestamp - always dim cyan
COLOR cyan
{
^(\[[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+Z\])
}

# Startup / health lifecycle - green
COLOR green
{
^\[[^\]]+\] (event=startup_begin)
^\[[^\]]+\] (event=startup_complete)
^\[[^\]]+\] (event=settings_loaded)
^\[[^\]]+\] (event=validating_security_invariants)
^\[[^\]]+\] (event=security_validation_passed)
^\[[^\]]+\] (event=loading_class_registry)
^\[[^\]]+\] (event=class_registry_loaded)
^\[[^\]]+\] (event=deferred_detection_initialized)
^\[[^\]]+\] (event=vision_config_loaded)
status=(healthy)
}

# Skipped / deferred / warnings - yellow
COLOR yellow
{
^\[[^\]]+\] (event=warmup_skipped)
^\[[^\]]+\] (event=yoloe_deferred_classes)
level=(warning|warn)
}

# Ingest pipeline - brightblue
COLOR brightblue
{
^\[[^\]]+\] (event=ingest_start)
^\[[^\]]+\] (event=ingest_complete)
^\[[^\]]+\] (event=ingest_photo_ids)
}

# Vision AI calls (slow async ops) - magenta
COLOR magenta
{
^\[[^\]]+\] (event=photo_suggest_vision_start)
^\[[^\]]+\] (event=vision_request_start)
^\[[^\]]+\] (event=vision_response)
^\[[^\]]+\] (event=photo_suggest_vision_done)
^\[[^\]]+\] (event=photo_suggest )
}

# YOLO model loading / reloading - brightyellow
COLOR brightyellow
{
^\[[^\]]+\] (event=yoloe_load)
^\[[^\]]+\] (event=yoloe_set_classes)
^\[[^\]]+\] (event=yoloe_reload_start)
^\[[^\]]+\] (event=yoloe_reload_done)
}

# Bin / item CRUD + class ops + outcomes - brightgreen
COLOR brightgreen
{
^\[[^\]]+\] (event=bins_list)
^\[[^\]]+\] (event=bin_get)
^\[[^\]]+\] (event=bin_item_update)
^\[[^\]]+\] (event=item_create)
^\[[^\]]+\] (event=item_associate)
^\[[^\]]+\] (event=class_confirm)
^\[[^\]]+\] (event=photo_outcomes)
}

# HTTP 200 OK - white
COLOR white
{
^\[[^\]]+\] (HTTP Request: .*"HTTP/[0-9.]+ 200)
level=(info)
}

# HTTP client/server errors - brightred
COLOR brightred
{
^\[[^\]]+\] (HTTP Request: .*"HTTP/[0-9.]+ [45][0-9][0-9])
level=(error)
}

# Key in key=value - blue (overrides line colors)
COLOR blue
{
(^|[[:space:]])([a-zA-Z0-9_-]+)=
[[:space:]][^[:space:]]+[[:space:]]([a-zA-Z0-9_-]+)=
[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]]([a-zA-Z0-9_-]+)=
[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]]([a-zA-Z0-9_-]+)=
[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]]([a-zA-Z0-9_-]+)=
[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]][^[:space:]]+[[:space:]]([a-zA-Z0-9_-]+)=
}
