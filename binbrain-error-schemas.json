{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://binbrain.local/schemas/error.response.json",
	"title": "ErrorResponse",
	"type": "object",
	"required": [
		"version",
		"error"
	],
	"properties": {
		"version": {
			"type": "string",
			"enum": [
				"1"
			]
		},
		"error": {
			"type": "object",
			"required": [
				"code",
				"message"
			],
			"properties": {
				"code": {
					"type": "string",
					"minLength": 1
				},
				"message": {
					"type": "string",
					"minLength": 1
				},
				"details": {
					"description": "Optional structured info for debugging / UI hints",
					"type": [
						"object",
						"array",
						"string",
						"number",
						"boolean",
						"null"
					]
				},
				"request_id": {
					"description": "Optional request correlation id if you add it later",
					"type": "string",
					"minLength": 1
				}
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false
}